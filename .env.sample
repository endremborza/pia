# papercli environment — copy to .env (gitignored) and fill in.
# Loaded by the launcher, never by the library:
#   uv run --env-file .env --extra server papercli serve
#   npx playwright test          # playwright.config.ts reads .env itself
# Env beats config-file keys for everything below.

# --- service identity (free tiers) -------------------------------------------
# Contact address sent in the User-Agent to OpenAlex/Crossref/arXiv (polite pool).
# Costs nothing, marks you as a well-behaved client; always set it.
HALLUBIB_MAILTO=you@example.org

# OpenAlex: keyless = $0.10/day of free credits (~100 searches; by-DOI fetches are
# free), a free account key = $1/day (~1,000 searches) — openalex.org/settings/api.
# Resolving one paper costs at most a few cents of credits; a review a couple more.
#OPENALEX_API_KEY=

# Semantic Scholar: without a key you share a globally throttled pool (expect 429s);
# a free key gives a steady 1 request/second — semanticscholar.org/product/api.
# hallubib already paces S2 at 1.1s, so the free key is enough for everything here.
#S2_API_KEY=

# --- agent backend -----------------------------------------------------------
# claude-code (default): the box's Claude Code login; Anthropic auth env vars are
#   scrubbed from the child so an exported API key can never bill silently.
# claude-api: bills the Anthropic API; refuses to start without ANTHROPIC_API_KEY.
# Or any name defined under [agent.backends.<name>] in the papercli config.
#PAPERCLI_AGENT_BACKEND=claude-code
#ANTHROPIC_API_KEY=

# --- papercli ----------------------------------------------------------------
# Set to gate every request (except /api/health) behind HTTP Basic auth — any
# username, this password. The one switch for public-facing deploys: the docker
# container reads it from this file at `docker compose up`. Unset = open.
#PAPERCLI_PASSWORD=

# Alternate user-config path (tests point this at a throwaway toml).
#PAPERCLI_CONFIG=

# Colon-separated dirs tectonic also searches, for classes outside its bundle
# (llncs & co). `make texmf` downloads them there. The docker image needs none
# of this — its tectonic is pre-wired.
#PARITEX_SEARCH_PATHS=~/.local/share/papercli/texmf
